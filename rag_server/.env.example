
# Needed for CRAG grading with Groq (free key at console.groq.com)
GROQ_API_KEY=your_key_here

# Optional: grade with a local Ollama model instead of Groq
# CRAG_PROVIDER=ollama
# CRAG_MODEL=llama3.1

# Optional: use a different Groq model if the default is retired
   # CRAG_MODEL=openai/gpt-oss-20b
