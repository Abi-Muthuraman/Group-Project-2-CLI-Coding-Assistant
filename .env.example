# Copy this file to .env and fill in your keys. Never commit .env.

# Which model provider the agent uses: groq or ollama
FORGE_PROVIDER=groq

# Groq (free key at console.groq.com)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Tavily web search (free key at app.tavily.com)
TAVILY_API_KEY=your_tavily_key_here

# Model that grades chunks in the RAG server
CRAG_MODEL=openai/gpt-oss-20b

# confirm = ask before each tool call, auto = run without asking
FORGE_EXECUTION_MODE=confirm

# Optional: local models with Ollama
# FORGE_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5-coder:7b
